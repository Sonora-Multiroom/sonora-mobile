# Gradle / Kotlin
.gradle/
build/
.kotlin/
local.properties
*.apk
*.aab

# IDE
.idea/
*.iml
.DS_Store

# Xcode
iosApp/**/xcuserdata/
iosApp/**/*.xcworkspace/xcuserdata/
DerivedData/


# Spec Kit tooling is generated per machine, not shared: PowerShell scripts locally,
# sh scripts in cloud sessions (see scripts/cloud-speckit-init.sh). Only memory/ is shared.
.claude/skills/speckit-**
.gemini/commands/speckit.**
.github/agents/speckit.**
.github/prompts/speckit.**
.kilocode/workflows/speckit.**
.specify/*
!.specify/archive/
!.specify/memory/
!.specify/feature.json
specs/archive/
specs/drafts/

# Spec Kit quality-gate checklists: useful only while a feature is being
# specified/planned, redundant once implemented — never commit these.
specs/*/checklists/requirements.md
.specify/archive/*/checklists/requirements.md
